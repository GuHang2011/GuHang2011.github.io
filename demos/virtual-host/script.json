  "segments": [
    {
      "title": "欢迎来到丝路智链",
      "titleEn": "Welcome to Silk Road Intelligence",
      "gesture": "welcome",
      "zh": "你好，我是丝路智链的虚拟讲解员小林。这段视频展示项目中的二维角色、讲稿和语音如何协同工作。",
      "en": "Hello, I am Lin, the virtual presenter for Silk Road Intelligence. This video shows how the project combines a 2D character, a script and speech.",
      "duration": 9.504,
      "start": 0
    },
    {
      "title": "商品讲解与信息核对",
      "titleEn": "Explain a product, verify its details",
      "gesture": "present",
      "zh": "以草原蜂蜜教学样品为例，先核对名称、规格和产地，再组织讲解。这里的商品是合成示例，不对应真实交易。",
      "en": "Using a synthetic steppe-honey sample, verify its name, specification and origin before preparing the narration. No real transaction is shown.",
      "duration": 10.416,
      "start": 9.504
    },
    {
      "title": "可控制的播放过程",
      "titleEn": "Keep playback under control",
      "gesture": "nod",
      "zh": "讲解可以暂停、重播和切换章节。字幕、手势与播放进度联动，方便复查。当前使用卡通角色与合成语音，下一步再验证更精细的口型同步。",
      "en": "Pause, replay or switch chapters. Captions, gestures and playback progress move together for review. This version uses a cartoon and synthesized speech; precise lip sync is future work.",
      "duration": 14.208,
      "start": 19.92
    }
  ]
